```python
import requests
import os

# Replace 'YOUR_API_KEY' with the actual API Key from the environment variable ZHIPUAI_API_KEY
api_key = os.getenv('ZHIPUAI_API_KEY')

# Replace 'api_url' with the actual API endpoint URL for async/chat/completions
api_url = 'https://api.bigmodel.cn/v1/async/chat/completions'

# Sample sentences for sentiment classification
sentences = [
    "I love this product!",
    "This is terrible, I don't like it.",
    "It's okay, nothing special."
]

# Function to send requests to the async/chat/completions endpoint
def classify_sentiment(sentence):
    headers = {
        'Authorization': f'Bearer {api_key}',
        'Content-Type': 'application/json'
    }
    data = {
        'text': sentence
    }
    response = requests.post(api_url, headers=headers, json=data)
    return response.json()

# Function to check the model version used by the API
def check_model_version():
    headers = {
        'Authorization': f'Bearer {api_key}',
        'Content-Type': 'application/json'
    }
    response = requests.get('https://api.bigmodel.cn/v1/model/version', headers=headers)
    return response.json()['model_version']

# Main script execution
if __name__ == '__main__':
    # Run sentiment classification on all sentences
    for sentence in sentences:
        result = classify_sentiment(sentence)
        print(f"Sentence: {sentence}")
        print(f"Sentiment classification result: {result}")
    
    # Check and print the model version
    model_version = check_model_version()
    print(f"I requested the model: glm-4.6")
    print(f"API actually used the model: {model_version}")
    
    # If the model versions do not match, raise an alarm
    if model_version != 'glm-4.6':
        print("ALARM: The model version used by the API does not match the requested glm-4.6 model.")
```

