��送 POST 请求。请注意，这段代码仅供参考，因为它不能在没有有效 API 密钥的情况下运行。

```python
import os
import requests

# 读取环境变量中的 API 密钥
api_key = os.environ['ZHIPUAI_API_KEY']

# 要分析的文本列表
texts = [
    "这家店服务太差了，再也不来了",
    "东西还行吧，没什么特别的",
    "太惊喜了，比我预期好太多，强烈推荐"
]

# 情感分类结果存储
results = []

# 对每个文本进行情感分类
for text in texts:
    # 构造请求参数
    payload = {
        "model": "glm-5.3",
        "messages": [{"role": "user", "content": text}]
    }
    
    # 发送请求
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    response = requests.post(
        "https://open.bigmodel.cn/api/paas/v4/chat/completions",
        headers=headers,
        json=payload
    )
    
    # 解析响应
    data = response.json()
    sentiment = data['choices'][0]['message']['content']
    score = float(data['choices'][0]['confidence'])
    
    # 将结果添加到结果列表
    results.append({"sentiment": sentiment, "score": score})

# 打印结果
for result in results:
    print(result)
```

