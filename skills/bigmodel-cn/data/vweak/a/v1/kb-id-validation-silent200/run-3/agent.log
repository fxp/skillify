import os
import requests

def check_kb_exists():
    api_key = os.environ['ZHIPUAI_API_KEY']
    kb_id = os.environ['ZHIPU_KB_ID']
    url = f"https://open.bigmodel.cn/api/paas/v4/knowledge/check/{kb_id}"
    headers = {"Authorization": f"Bearer {api_key}"}
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        print("Knowledge base exists and is accessible.")
    else:
        print("Knowledge base does not exist or is not accessible.")

if __name__ == "__main__":
