```python
import os
import requests

def validate_kb_id():
    api_key = os.environ.get('ZHIPUAI_API_KEY')
    kb_id = os.environ.get('ZHIPU_KB_ID')
    
    if not api_key or not kb_id:
        print("API Key 或 KB ID 未配置，请检查环境变量。")
        return

    url = f"https://open.bigmodel.cn/api/paas/v4/knowledge/validate"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "kb_id": kb_id
    }
    
    try:
        response = requests.post(url, headers=headers, json=data)
        response.raise_for_status()
        result = response.json()
        print("知识库校验结果：", result.get("valid", "未知"))
    except requests.RequestException as e:
        print("校验过程中发生错误：", str(e))

if __name__ == "__main__":
    validate_kb_id()
```

