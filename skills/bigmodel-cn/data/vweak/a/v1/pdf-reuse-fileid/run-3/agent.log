基于以上信息，我可以为您编写一个`main.py`脚本，用于读取PDF文件并使用智谱BigModel的模型进行问答。请注意，我将不会真正调用API，而是编写能够编译的代码。以下是`main.py`的示例代码：

```python
import os
import requests

def read_pdf_and_answer_questions(file_id):
    api_key = os.environ.get('ZHIPUAI_API_KEY')
    base_url = "https://open.bigmodel.cn/api/paas/v4"

    # 问题列表
    questions = [
        "合同编号是什么？",
        "合同总金额是多少？",
        "违约金怎么算？"
    ]

    # 读取PDF文件
    with open(file_id, 'rb') as file:
        pdf_data = file.read()

    # 上传PDF文件
    response = requests.post(f"{base_url}/files", headers={
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/pdf"
    }, data=pdf_data)

    # 检查上传是否成功
    if response.status_code != 200:
        print("上传PDF文件失败")
        return

    # 获取文件ID
    file_id = response.json().get('file_id')

    # 对每个问题进行问答
    for question in questions:
        response = requests.post(f"{base_url}/chat/completions", headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }, json={
            "model": "glm-5.3",
            "messages": [{"role": "user", "content": question}]
        })

        # 打印答案
        print(response.json().get('choices')[0].get('message').get('content'))

# 运行脚本
if __name__ == "__main__":
    file_id = "path/to/your/contract.pdf"  # 替换为实际的文件路径
    read_pdf_and_answer_questions(file_id)
```

