import os
import requests

def read_pdf_and_answer_questions(file_id, api_key):
    # 发送请求读取 PDF
    read_pdf_url = f"https://open.bigmodel.cn/api/paas/v4/files/parser/{file_id}"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    response = requests.post(read_pdf_url, headers=headers)
    pdf_content = response.json()

    # 提取 PDF 内容
    # 由于不使用本地 PDF 解析库，这一步可能需要根据实际 API 返回的数据进行调整

    # 提问并获取答案
    questions = [
        "合同编号是什么",
        "合同总金额是多少",
        "违约金怎么算"
    ]
    for question in questions:
        prompt = {"role": "user", "content": question}
        chat_url = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
        response = requests.post(chat_url, headers=headers, json={
            "model": "glm-5.3",
            "messages": [prompt]
        })
        answer = response.json()["choices"][0]["message"]["content"]
        print(answer)

if __name__ == "__main__":
    file_id = "your_file_id_here"
    api_key = os.environ["ZHIPUAI_API_KEY"]
    read_pdf_and_answer_questions(file_id, api_key)
```

