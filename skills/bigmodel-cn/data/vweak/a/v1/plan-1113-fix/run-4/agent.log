import os
import requests

# 读取环境变量中的GLM_KEY
api_key = os.environ.get('GLM_KEY')

# 检查API密钥是否设置
if not api_key:
    print("未找到GLM_KEY环境变量，请设置该环境变量并重新运行。")
else:
    # 发送请求到模型
    response = requests.post(
        "https://open.bigmodel.cn/api/paas/v4/chat/completions",
        headers={"Authorization": f"Bearer {api_key}"},
        json={
            "model": "glm-5.3",
            "messages": [{"role": "user", "content": "用一句话介绍 Python"}]
        }
    )

    # 打印模型回答
    print(response.json().get('data', {}).get('results', [{}])[0].get('content'))
```

