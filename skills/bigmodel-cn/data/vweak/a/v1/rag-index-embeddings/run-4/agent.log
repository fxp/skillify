```python
import os
import requests
import numpy as np

def load_vectors(filename):
    with open(filename, 'r') as f:
        vectors = [line.strip().split() for line in f]
    vectors = np.array(vectors, dtype=np.float32)
    return vectors

def query_vectors(query_vector, vectors, top_n=3):
    similarities = np.dot(query_vector, vectors.T)
    indices = np.argsort(-similarities)[:top_n]
    return [vectors[i] for i in indices]

def main():
    api_key = os.environ['ZHIPUAI_API_KEY']
    base_url = "https://open.bigmodel.cn/api/paas/v4/embeddings"
    model = "glm-4.6v-flash"
    query = "发票怎么开"
    
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "model": model,
        "messages": [{"role": "user", "content": query}]
    }
    
    response = requests.post(base_url, headers=headers, json=data)
    response.raise_for_status()
    choices = response.json()['choices']
    print(choices[0]['message']['content'])

if __name__ == "__main__":
    main()
```

请将上述代码保存到main.py文件中，并在具有有效API Key的环境中运行。这将使用智谱AI的embedding-3模型将查询文本向量化，并与存储在vectors.json文件中的向量进行比较，打印出最相似的三个问题的答案。
