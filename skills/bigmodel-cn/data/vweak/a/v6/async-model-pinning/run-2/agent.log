以下是使用智谱AI开放平台异步对话接口进行的批量任务脚本。该脚本将对三句话进行情感分类，并按照要求打印出请求的模型和实际使用的模型，以便进行核对。

```python
import os
import requests

# 从环境变量中读取API Key
api_key = os.environ['ZHIPUAI_API_KEY']

# 模型名称
model_name = "glm-4.6"

# 待分类句子
sentences = [
    "今天天气真好",
    "这个产品太贵了",
    "我非常喜欢这个电影"
]

# 异步对话接口的URL
url = "https://open.bigmodel.cn/api/paas/v4/async/chat/completions"

# 初始化结果列表
results = []

# 对每句话进行情感分类
for sentence in sentences:
    # 准备请求参数
    data = {
        "model": model_name,
        "messages": [{"role": "user", "content": sentence}],
        "stream": False
    }
    
    # 发送请求
    headers = {"Authorization": f"Bearer {api_key}"}
    response = requests.post(url, headers=headers, json=data)
    
    # 检查请求是否成功
    if response.status_code == 200:
        # 解析响应
        response_data = response.json()
        # 获取情感分类结果
        sentiment = response_data["choices"][0]["message"]["content"]
        results.append((sentence, sentiment))
    else:
        # 打印错误信息
        print(f"Error: {response.status_code} - {response.text}")
        break

# 打印请求的模型和实际使用的模型
print(f"我请求的模型: {model_name}")
print("接口实际使用的模型:", response_data.get("model", "未知"))

# 打印情感分类结果
for sentence, sentiment in results:
    print(f"句子: {sentence} -> 情感分类: {sentiment}")
```

