```python
import json
import requests

# 从环境变量中获取 API 密钥
api_key = os.getenv('ZHIPUAI_API_KEY')

# 构造请求文件的内容
data = {
    "requests": [
        {
            "text": "这是一条测试评论"
        }
    ]
}

# 将请求文件转换为 JSONL 格式
with open('data.jsonl', 'w') as f:
    json.dump(data, f)

# 上传请求文件
files = {'file': open('data.jsonl', 'r')}
response = requests.post('https://api.zhipu.ai/batch', headers={'Authorization': f'Bearer {api_key}'}, files=files)

# 打印创建成功的 batch 任务 id
if response.status_code == 201:
    batch_task_id = response.json().get('batch_task_id')
    print(batch_task_id)
else:
    print('Failed to create batch task')
```

