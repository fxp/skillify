import json
import requests

# Function to create a .jsonl file with user comments
def create_jsonl_file(comments_file_path, output_file_path):
    with open(comments_file_path, 'r', encoding='utf-8') as file:
        with open(output_file_path, 'w', encoding='utf-8') as outfile:
            for line in file:
                outfile.write(json.dumps({"text": line.strip()}) + '\n')

# Function to upload the .jsonl file and create a batch task
def upload_and_create_batch_task(jsonl_file_path):
    api_key = os.getenv('ZHIPUAI_API_KEY')
    url = f"https://api.zhipu.ai/batch/v1/tasks"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "data": [f"file://{jsonl_file_path}"]
    }
    response = requests.post(url, headers=headers, json=data)
    return response.json()

# Main function to run the script
def main():
    comments_file_path = 'comments.txt'
    output_file_path = 'comments.jsonl'
    create_jsonl_file(comments_file_path, output_file_path)
    batch_task_response = upload_and_create_batch_task(output_file_path)
    print(batch_task_response['task_id'])

if __name__ == "__main__":
    main()
```

