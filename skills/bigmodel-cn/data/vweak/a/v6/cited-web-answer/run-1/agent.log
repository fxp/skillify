以下是`main.py`脚本的内容：

```python
import requests

def get_zhipu_answer(question):
    # 使用环境变量中的API Key
    api_key = os.getenv('ZHIPUAI_API_KEY')
    if not api_key:
        print("未找到有效的API Key。")
        return

    # 构建API请求URL
    url = f"https://api.zhipu.ai/v1/search?question={question}&api_key={api_key}"
    
    # 发送API请求
    response = requests.get(url)
    
    # 检查响应状态码
    if response.status_code == 200:
        # 处理返回的数据
        data = response.json()
        # 假设返回的数据中有答案和来源信息
        answer = data.get('answer')
        sources = data.get('sources')
        
        # 打印答案
        print(answer)
        
        # 打印来源信息
        if sources:
            print("\n参考信息来源：")
            for source in sources:
                title = source.get('title')
                url = source.get('url')
                print(f"{title} - [链接](#{url})")
        else:
            print("未找到参考信息来源。")
    else:
        print("请求API时发生错误。")

if __name__ == "__main__":
    question = "2026年智谱BigModel发布了哪些新模型"
    get_zhipu_answer(question)
```

