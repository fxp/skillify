```python
import os
import requests

def validate_kb(kb_id):
    base_url = "https://open.bigmodel.cn/api/paas/v4/knowledge-libraries"
    headers = {
        "Authorization": f"Bearer {os.environ['ZHIPUAI_API_KEY']}"
    }
    response = requests.get(f"{base_url}/{kb_id}", headers=headers)
    if response.status_code == 200:
        print(f"Knowledge base with ID {kb_id} exists and is usable.")
    else:
        print(f"Knowledge base with ID {kb_id} does not exist or is not usable.")

if __name__ == "__main__":
    kb_id = os.environ.get('ZHIPU_KB_ID')
    if kb_id:
        validate_kb(kb_id)
    else:
        print("ZHIPU_KB_ID environment variable is not set.")
```

