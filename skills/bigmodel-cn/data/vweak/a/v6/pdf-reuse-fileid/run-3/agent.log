import os
import requests

def read_pdf_and_answer_questions(file_path):
    base_url = "https://open.bigmodel.cn/api/paas/v4"
    headers = {
        "Authorization": f"Bearer {os.environ['ZHIPUAI_API_KEY']}",
        "Content-Type": "application/json"
    }

    # 上传文件
    with open(file_path, "rb") as f:
        files = {"file": ("file.pdf", f, "application/pdf")}
        response = requests.post(f"{base_url}/files", headers=headers, files=files)
        response.raise_for_status()
        file_data = response.json()
        file_id = file_data["id"]

    # 提问并获取答案
    questions = [
        "合同编号是什么",
        "合同总金额是多少",
        "违约金怎么算"
    ]

    for question in questions:
        data = {
            "model": "glm-5.3",
            "messages": [
                {"role": "user", "content": [{"type": "file", "file": {"file_id": file_id}}],
                 {"type": "text", "text": question}]
            }
        }
        response = requests.post(f"{base_url}/chat/completions", headers=headers, json=data)
        response.raise_for_status()
        answer = response.json()["choices"][0]["message"]["content"]
        print(f"{question}: {answer}")

# 使用示例
file_path = "/path/to/contract.pdf"
read_pdf_and_answer_questions(file_path)
```

