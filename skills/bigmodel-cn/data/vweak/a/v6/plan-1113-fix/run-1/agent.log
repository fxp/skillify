import os
import requests

# 读取环境变量 GLM_KEY
key = os.environ.get('GLM_KEY')

# 检查 GLM_KEY 是否已设置
if not key:
    print("Error: GLM_KEY environment variable is not set.")
else:
    # 构建请求头
    headers = {
        "Authorization": f"Bearer {key}"
    }

    # 构建请求体
    data = {
        "model": "glm-5.3",
        "messages": [
            {"role": "user", "content": "用一句话介绍 Python"}
        ]
    }

    # 发送请求
    response = requests.post("https://open.bigmodel.cn/api/paas/v4/chat/completions", headers=headers, json=data)

    # 检查响应状态码
    if response.status_code == 200:
        # 打印模型回答
        print(response.json()['choices'][0]['message']['content'])
    else:
        # 打印错误信息
        print(f"Error: {response.json()['error']['message']}")
```

