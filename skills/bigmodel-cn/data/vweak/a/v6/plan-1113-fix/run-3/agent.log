import os
import requests

# 从环境变量中获取 GLM_KEY
api_key = os.environ['GLM_KEY']

# 使用请求 API
r = requests.post("https://open.bigmodel.cn/api/paas/v4/chat/completions", headers={"Authorization": f"Bearer {api_key}"}, json={
    "model": "glm-5.3",
    "messages": [{"role": "user", "content": "用一句话介绍 Python"}]
})

# 打印结果
print(r.json())
