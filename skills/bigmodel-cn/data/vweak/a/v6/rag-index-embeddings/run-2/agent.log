```python
import os
import requests
import json
from sklearn.metrics.pairwise import cosine_similarity

# Read API key from environment variable
api_key = os.environ.get('ZHIPUAI_API_KEY')

# Read FAQ file
with open('faq.txt', 'r', encoding='utf-8') as f:
    faq_lines = f.readlines()

# Vectorize each line using the embedding model
vectors = []
for line in faq_lines:
    response = requests.post(
        "https://open.bigmodel.cn/api/paas/v4/embeddings",
        headers={"Authorization": f"Bearer {api_key}"},
        json={"model": "embedding-3", "input": [line.strip()]}
    )
    response.raise_for_status()
    data = response.json()
    vectors.append(data['data'][0]['embedding'])

# Query vector for "发票怎么开"
query_vector = vectors[faq_lines.index("发票怎么开".strip())]

# Compute cosine similarity
cosine_scores = [cosine_similarity(query_vector, vec)[0][0] for vec in vectors]

# Get top 3 similar lines
top_3_indices = sorted(range(len(cosine_scores)), key=lambda i: cosine_scores[i], reverse=True)[:3]
top_3_lines = [faq_lines[i].strip() for i in top_3_indices]

# Print the top 3 similar lines
for line in top_3_lines:
    print(line)
```

This script reads the FAQ file, vectorizes each line using the embedding model, and then computes the cosine similarity between the query vector and each line vector. It prints the top 3 similar lines based on cosine similarity.
