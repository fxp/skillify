import os
import requests
import json
import numpy as np

# API Key from environment variable
api_key = os.environ['ZHIPUAI_API_KEY']
base_url = "https://open.bigmodel.cn/api/paas/v4"

def get_embedding(text):
    response = requests.post(
        f"{base_url}/embeddings",
        headers={"Authorization": f"Bearer {api_key}"},
        json={"model": "embedding-3", "input": [text]}
    )
    response.raise_for_status()
    return response.json()['data'][0]['embedding']

def search(query):
    query_embedding = get_embedding(query)
    faq_embeddings = [get_embedding(line) for line in faq_lines]

    similarities = np.dot(query_embedding, faq_embeddings)
    top_3_indices = np.argsort(similarities)[-3:]
    return [faq_lines[i] for i in top_3_indices]

# Read the FAQ file
with open("faq.txt", "r", encoding="utf-8") as faq_file:
    faq_lines = faq_file.readlines()

# Query and print the top 3 similar FAQs
query = "发票怎么开"
results = search(query)
for result in results:
