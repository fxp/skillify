import requests
import os

# 从环境变量中获取API密钥
api_key = os.getenv('ZHIPUAI_API_KEY')

# 智谱知识库API的URL（需要替换为实际的URL）
knowledge_base_url = 'https://api.zhipu.ai/v1/knowledge_base'

# 要上传的文本内容（从本地文件获取）
with open('faq.txt', 'r', encoding='utf-8') as file:
    text_content = file.read()

# 构造请求头
headers = {
    'Authorization': f'Bearer {api_key}',
    'Content-Type': 'application/json'
}

# 构造请求体
data = {
    'content': text_content
}

# 发送POST请求上传文本到知识库
response = requests.post(knowledge_base_url, headers=headers, json=data)

# 打印响应结果
print(response.text)

# 检索问题并打印结果
search_question = '退换货政策的有效期是多久'
search_data = {
    'question': search_question
}

# 发送POST请求检索知识库
search_response = requests.post(knowledge_base_url + '/search', headers=headers, json=search_data)

# 打印检索结果
print(search_response.text)
```

