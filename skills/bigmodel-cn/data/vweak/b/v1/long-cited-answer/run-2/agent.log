def fetch_search_results(search_query, api_key):
    # 构建搜索请求的 URL
    url = f"https://api.zhipu.ai/v2/search?query={search_query}&api_key={api_key}"
    
    # 发送 GET 请求
    response = requests.get(url)
    
    # 检查响应状态码
    if response.status_code == 200:
        # 解析 JSON 数据
        results = response.json()
        return results
    else:
        # 处理错误情况
        print(f"Error: {response.status_code}")
        return None

def main():
