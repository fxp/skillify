```python
import requests
import json

def fetch_search_results(query, api_key):
    url = "https://api.zhipu.ai/v2/search"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "query": query,
        "page": 1,
        "size": 10
    }
    response = requests.post(url, headers=headers, data=json.dumps(data))
    return response.json()

def main():
    api_key = os.getenv("ZHIPUAI_API_KEY")
    if not api_key:
        print("API Key未设置。")
        return
    
    query = "2026 年中国新能源汽车出口的主要目的地国家"
    results = fetch_search_results(query, api_key)
    
    if "items" in results:
        items = results["items"]
        print("搜索结果：")
        for item in items:
            title = item["title"]
            url = item["url"]
            print(f"标题：{title}")
            print(f"链接：{url}\n")
    else:
        print("未找到搜索结果。")

if __name__ == "__main__":
    main()
```

