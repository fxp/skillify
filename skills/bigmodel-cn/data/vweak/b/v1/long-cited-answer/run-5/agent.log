import requests

def get_new_energy_car_export_info():
    api_key = os.getenv('ZHIPUAI_API_KEY')
    if not api_key:
        raise ValueError("环境变量ZHIPUAI_API_KEY未设置")
    
    url = "https://api.zhipu.ai/v1/search"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = {
        "query": "2026 年中国新能源汽车出口的主要目的地国家有哪些"
    }
    
    response = requests.post(url, headers=headers, json=data)
    if response.status_code != 200:
        raise Exception(f"请求失败，状态码：{response.status_code}")
    
    return response.json()

if __name__ == "__main__":
    try:
        result = get_new_energy_car_export_info()
        print(result)
    except Exception as e:
        print(f"获取数据失败：{e}")
        # 在这里添加至少两个可点击的来源链接
        print("<a href='http://example.com/source1'>来源1</a>")
        print("<a href='http://example.com/source2'>来源2</a>")
```

