import os
import requests

def rerank_documents(documents, api_key):
    # Base URL for the Zhipu AI API
    base_url = "https://open.bigmodel.cn/api/paas/v4/rerank"

    # Prepare the data payload
    payload = {
        "model": "glm-5.3",
        "documents": documents,
        "api_key": api_key
    }

    # Make the POST request to the rerank endpoint
    response = requests.post(base_url, json=payload)

    # Check if the request was successful
    if response.status_code == 200:
        # Extract the results from the response
        results = response.json()
        ranked_documents = results.get("ranked_documents", [])

        # Print the documents in order of their rerank scores
        for document in ranked_documents:
            print(document["text"])
            print(document["score"])
            print("---")
    else:
        print("Failed to rerank documents. Status code:", response.status_code)

# Read the API key from the environment variable
api_key = os.getenv("ZHIPUAI_API_KEY")

