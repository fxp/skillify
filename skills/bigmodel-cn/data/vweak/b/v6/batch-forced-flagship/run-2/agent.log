import os
import requests

# 读取环境变量中的API Key
api_key = os.getenv('ZHIPUAI_API_KEY')

# 定义请求头，包括API Key
headers = {
    'Authorization': f'Bearer {api_key}',
    'Content-Type': 'application/json'
}

# 定义批量处理API的URL
batch_url = 'https://open.bigmodel.cn/api/paas/v4/batches'

# 定义上传文件的URL
files_url = 'https://open.bigmodel.cn/api/paas/v4/files'

# 定义上传文件的参数
files_data = {
    'purpose': 'batch'
}

# 上传文件
response = requests.post(files_url, headers=headers, files={'file': ('b.jsonl', open('b.jsonl', 'w'), 'application/json')})

# 读取上传文件返回的文件ID
file_id = response.json().get('id')

# 创建批量任务
batch_data = {
    'input_file_id': file_id,
    'endpoint': '/v4/chat/completions',
    'completion_window': '24h'
}

# 发送创建批量任务的请求
batch_response = requests.post(batch_url, headers=headers, json=batch_data)

# 打印批量任务的ID
batch_id = batch_response.json().get('id')
batch_id
