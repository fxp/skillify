import os
import requests

def main():
    api_key = os.environ['ZHIPUAI_API_KEY']
    base_url = "https://open.bigmodel.cn/api/"

    # 构造JSONL文件
    with open('comments.jsonl', 'w') as f:
        for line in comments.txt:
            f.write(json.dumps({"content": line}) + '\n')

    # 上传JSONL文件
    files = {'file': ('comments.jsonl', open('comments.jsonl', 'rb'), 'application/json')}
    response = requests.post(f"{base_url}/files", headers={"Authorization": f"Bearer {api_key}"}, files=files)
    file_id = response.json()['id']

    # 创建Batch任务
    batch_response = requests.post(f"{base_url}/batches", headers={"Authorization": f"Bearer {api_key}"}, json={
        "input_file_id": file_id,
        "endpoint": "/v4/chat/completions",
        "completion_window": "24h"
    })
    batch_id = batch_response.json()['id']

    # 打印Batch ID
    print("Batch ID:", batch_id)

if __name__ == "__main__":
    main()
