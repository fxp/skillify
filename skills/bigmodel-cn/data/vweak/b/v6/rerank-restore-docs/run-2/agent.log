import os
import requests

# 读取API Key
api_key = os.environ['ZHIPUAI_API_KEY']

# 候选文档
documents = [
    "签收后 15 日内可无理由退货，商品需保持完好",
    "增值税专用发票需在订单完成后 7 个工作日内申请，逾期需联系客服",
    "公司地址位于北京市海淀区，工作日 9:00-18:00 办公",
    "普通发票支持随时申请，无时间限制",
    "满 199 元包邮，偏远地区除外"
]

# 重排序API URL
rerank_url = "https://open.bigmodel.cn/api/paas/v4/rerank"

# 请求头
headers = {
    "Authorization": f"Bearer {api_key}",
    "Content-Type": "application/json"
}

# 请求参数
data = {
    "model": "glm-5.3",
    "documents": documents
}

# 发送请求
response = requests.post(rerank_url, headers=headers, json=data)

# 打印结果
for i, doc in enumerate(documents):
    print(f"原文：{doc}")
    print(f"分数：{response.json()['results'][i]['score']}\n")
```

请将以上代码保存为 `main.py`，并在有有效API Key的环境中运行。
