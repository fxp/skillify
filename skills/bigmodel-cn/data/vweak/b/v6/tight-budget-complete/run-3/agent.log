import os
import requests

def generate_report(api_key, max_tokens=1000):
    base_url = "https://open.bigmodel.cn/api/paas/v4"
    headers = {"Authorization": f"Bearer {api_key}"}

    prompt = {
        "model": "glm-5.3",
        "messages": [
            {"role": "user", "content": "请生成一份关于2026年中国新能源汽车出口的市场简报，包含小标题和数据。"}
        ],
        "max_tokens": max_tokens
    }

    response = requests.post(f"{base_url}/chat/completions", headers=headers, json=prompt)
    if response.status_code == 200:
        content = response.json().get("choices", [{}])[0].get("message", {}).get("content", "")
        return content
    else:
        return "生成市场简报失败，请检查API Key是否有效。"

if __name__ == "__main__":
    api_key = os.getenv("ZHIPUAI_API_KEY")
    if not api_key:
        print("未设置ZHIPUAI_API_KEY环境变量。")
    else:
        report = generate_report(api_key)
        print(report)
        print("实际字数：", len(report.splitlines()))
