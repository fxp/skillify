  "results": [
    {"sentiment": "负面", "score": 0.8},
    {"sentiment": "中性", "score": 0.3},
    {"sentiment": "正面", "score": 0.95}
  ],
  "summary": {
    "total_texts": 3,
    "positive_count": 1,
    "negative_count": 1,
    "neutral_count": 1
  }
}
```

