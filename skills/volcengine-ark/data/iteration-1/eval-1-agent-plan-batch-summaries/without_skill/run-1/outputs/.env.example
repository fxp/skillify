# Copy to .env and `source` it (or use direnv). Never commit the real file.

# Key shown on the Ark console -> Agent Plan (套餐) page. It is an Ark API key
# that the plan is bound to. Read only from the environment by the script.
export ARK_API_KEY=""

# Plan Base URL from the same page. This is what routes billing to the plan.
# The pay-as-you-go endpoint https://ark.cn-beijing.volces.com/api/v3 is REFUSED
# by the script unless you pass --allow-postpaid.
export ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"

# Model to use, and the comma-separated allow-list of models your plan covers.
# Copy the list from the plan page; the script refuses models outside it.
export ARK_MODEL="doubao-seed-2.0-lite"
export ARK_PLAN_MODELS="doubao-seed-2.0-lite"

# Optional tuning
export ARK_CONCURRENCY=3
export NOTES_DIR=notes
export SUMMARIES_DIR=summaries
