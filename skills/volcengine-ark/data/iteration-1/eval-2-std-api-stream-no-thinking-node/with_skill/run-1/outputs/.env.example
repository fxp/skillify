# ===== 必填 =====
# 方舟 API Key（控制台 → API Key 管理）。标准后付费入口用的就是这把 Key。
# 注意：不是 Agent Plan 专属 Key；Agent Plan Key 打 /api/v3 会 401 AuthenticationError。
ARK_API_KEY=

# ===== 可选（有默认值）=====
# 标准后付费入口。不要改成 /api/plan/v3 或 /api/coding/v3（那两个是套餐入口，Key / model 格式都不同）。
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 标准入口用「带日期的 Model ID」（连字符），不是 Plan 入口的小写 Model Name（doubao-seed-2.0-lite）。
# 也可以填控制台创建的推理接入点 ID：ep-xxxxxxxx-xxxxx
# ARK_MODEL=doubao-seed-2-0-lite-260428

# 回答最大 token（思考已关闭，所以 max_tokens 只限回答本身即可）
# ARK_MAX_TOKENS=1024

# 采样温度 [0, 2]；不设则用模型默认值
# ARK_TEMPERATURE=

# 客服人设 / 知识边界（覆盖脚本内置 system prompt）
# CS_SYSTEM_PROMPT=你是某某公司的在线客服……

# 打印每个 SSE chunk 的原始 JSON 到 stderr，排障用
# ARK_DEBUG=1
