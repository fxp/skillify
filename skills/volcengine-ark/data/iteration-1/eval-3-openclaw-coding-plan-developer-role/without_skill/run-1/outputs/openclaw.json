{
  "models": {
    "mode": "merge",
    "providers": {
      "volcengine-coding": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "${ARK_API_KEY}",
        "api": "openai-completions",
        "compat": {
          "supportsDeveloperRole": false,
          "supportsStore": false,
          "supportsReasoningEffort": false
        },
        "models": [
          {
            "id": "doubao-seed-2.0-lite",
            "name": "Doubao Seed 2.0 Lite (Coding Plan)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 256000,
            "maxTokens": 32000
          },
          {
            "id": "doubao-seed-2.0-pro",
            "name": "Doubao Seed 2.0 Pro (Coding Plan)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 256000,
            "maxTokens": 32000
          },
          {
            "id": "doubao-seed-2.0-code",
            "name": "Doubao Seed 2.0 Code (Coding Plan)",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 256000,
            "maxTokens": 32000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "volcengine-coding/doubao-seed-2.0-lite"
      }
    }
  }
}
