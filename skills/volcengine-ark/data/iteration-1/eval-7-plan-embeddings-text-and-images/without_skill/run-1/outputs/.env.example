# 火山方舟 API Key（控制台 -> API Key 管理）。Agent Plan 的 Key 与按量付费 Key 形态相同。
ARK_API_KEY=

# 方舟 OpenAI 兼容网关。若你的 Agent Plan 控制台给出了专属 base_url，请替换此处。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 向量化后端：
#   multimodal -> 文本与图片统一进入同一向量空间（默认，图片可被文本查询召回）
#   text       -> 仅文本，走标准 OpenAI /embeddings 接口，图片会被跳过
EMBED_BACKEND=multimodal

# 模型：也可以填控制台里创建的接入点 ID（ep-xxxxxxxx）
ARK_MULTIMODAL_MODEL=doubao-embedding-vision-250615
ARK_TEXT_MODEL=doubao-embedding-large-text-250515

# 输出向量维度。留空表示使用模型原生维度（vision-250615 为 2048，large-text-250515 为 2048）。
# 两个模型都支持 Matryoshka 截断（2048/1024/512/256）。
EMBED_DIM=

# 数据目录
NOTES_DIR=notes
IMAGES_DIR=imgs
INDEX_DIR=.index
